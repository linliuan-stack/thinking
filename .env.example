# ── Database ──────────────────────────────────
DB_HOST=111.231.145.50
DB_PORT=2345
DB_NAME=thinking
DB_USER=postgres
DB_PASSWORD=tech-coffee

# ── JWT ───────────────────────────────────────
SECRET_KEY=thinking-secret-key-change-in-production

# ── Ports (host mapping) ─────────────────────
NGINX_PORT=80

# ── Docker Registry (镜像仓库, 可选) ─────────
# 留空则镜像只在本地; 设置后 deploy.sh push 会推送到该仓库
# 示例: docker.io/yourname | registry.cn-hangzhou.aliyuncs.com/yourns | ghcr.io/yourorg
REGISTRY=
TAG=latest

# ── Frontend Build (前端构建参数, 可选) ──────
# 留空 = 使用相对路径（通过 Nginx 网关代理, 推荐）
# 设置 = 前端独立部署时指向后端 API 地址
# 示例: https://api.example.com
API_BASE_URL=
